<?xml version="1.0" encoding="utf-8"?>
<!-- This week's distance, average split and speed, and workout count: the 2x2 week widget, and the left of the 4x2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView
        android:id="@+id/week_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_week_title"
        android:textColor="@color/widget_accent"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/week_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp" />
    <!-- Average split and speed: styled like week_count. -->
    <TextView
        android:id="@+id/week_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/week_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
    <!-- Spacer: RemoteViews can't inflate a plain View. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/week_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="-0.05"
            android:maxLines="1"
            android:text="@string/widget_week_placeholder"
            android:textColor="@color/widget_text"
            android:textSize="58sp" />
        <TextView
            android:id="@+id/week_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_week_unit_km"
            android:textColor="@color/widget_text_secondary"
            android:textSize="20sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/week_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
