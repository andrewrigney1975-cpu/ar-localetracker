<?xml version="1.0" encoding="utf-8"?>
<!-- What the FileProvider (Capacitor Share) may hand to other apps: the cache only, where
     screenshots (cache/shots) and exports (cache/exports) are written. External storage was
     shared too in Capacitor's template; nothing here needs it (security audit I-2). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="my_cache_images" path="." />
</paths>
